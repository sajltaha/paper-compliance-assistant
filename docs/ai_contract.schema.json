{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Criterion findings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "findings"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "status",
          "engine",
          "explanation",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "insufficient_evidence",
              "not_applicable"
            ]
          },
          "engine": {
            "enum": [
              "rule",
              "llm"
            ]
          },
          "explanation": {
            "type": "string"
          },
          "recommendation": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "block_id",
                "quote",
                "page"
              ],
              "properties": {
                "block_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "page": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
